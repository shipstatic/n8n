{
  "name": "n8n-nodes-shipstatic",
  "version": "1.0.1",
  "description": "Deploy static websites, landing pages, and prototypes instantly from n8n workflows. Free, no account needed.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "shipstatic",
    "deploy",
    "hosting",
    "website",
    "static-site",
    "static-hosting",
    "web-hosting",
    "vibe-coding",
    "ai"
  ],
  "license": "MIT",
  "author": {
    "name": "ShipStatic",
    "email": "hello@shipstatic.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shipstatic/n8n.git"
  },
  "homepage": "https://shipstatic.com",
  "main": "dist/nodes/Shipstatic/Shipstatic.node.js",
  "scripts": {
    "dev": "n8n-node dev",
    "build": "n8n-node build",
    "prepack": "pnpm run build",
    "test": "vitest",
    "coverage": "vitest --run --coverage",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "biome check .",
    "lint:n8n": "eslint . --max-warnings 0",
    "format": "biome format --write ."
  },
  "files": [
    "dist/credentials",
    "dist/nodes"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ShipstaticApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Shipstatic/Shipstatic.node.js"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@eslint/js": "^9.39.4",
    "@n8n/node-cli": "0.44.2",
    "@shipstatic/types": "2.22.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.4",
    "typescript": "^6.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
