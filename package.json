{
  "name": "n8n-nodes-shipstatic",
  "version": "1.0.0-beta.1",
  "description": "Deploy static sites and HTML pages to a live URL — free, no account needed",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "shipstatic",
    "deploy",
    "hosting",
    "website",
    "static-site",
    "static-hosting",
    "web-hosting",
    "vibe-coding",
    "ai"
  ],
  "license": "MIT",
  "author": {
    "name": "ShipStatic",
    "email": "hello@shipstatic.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shipstatic/n8n.git"
  },
  "homepage": "https://github.com/shipstatic/n8n#readme",
  "main": "dist/nodes/Shipstatic/Shipstatic.node.js",
  "scripts": {
    "dev": "n8n-node dev",
    "build": "n8n-node build",
    "test": "vitest",
    "coverage": "vitest --run --coverage",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "biome check .",
    "lint:n8n": "eslint .",
    "format": "biome format --write .",
    "prepare": "git config core.hooksPath scripts/githooks"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ShipstaticApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Shipstatic/Shipstatic.node.js"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@eslint/js": "^9.39.4",
    "@n8n/node-cli": "0.23.1",
    "@shipstatic/types": "2.5.0-beta.22",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.4",
    "typescript": "^6.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.16"
  }
}
